# ─────────────────────────────────────────────────────────────
# ألو المعلم · Alo Maalem — environment configuration
# Copy this file to `.env` and adjust the values.
# NEVER commit the real `.env` to version control.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ألو المعلم"

# ── Database (PostgreSQL) ────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://alomaalem:alomaalem_dev_password@127.0.0.1:5432/alomaalem?schema=public"
# Optional: a read-replica URL. Falls back to DATABASE_URL when unset.
# DATABASE_READ_URL=""

# ── Authentication ───────────────────────────────────────────
# Secret used to sign session tokens (HS256). Generate with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-value"
# Session lifetime in seconds (default: 7 days)
AUTH_SESSION_MAX_AGE=604800
# Cookie name prefix — change only if you run several apps on one domain
AUTH_COOKIE_NAME="alomaalem_session"

# ── Rate limiting ────────────────────────────────────────────
# In-memory limiter is used by default. Set RATE_LIMIT_DRIVER=redis
# and provide REDIS_URL to switch to a shared store (no code changes).
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_MAX=8
# REDIS_URL="redis://localhost:6379"

# ── File storage (pluggable provider) ────────────────────────
# One of: local | cloudinary | s3
STORAGE_PROVIDER=local
# local provider
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
# cloudinary provider
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# s3 provider
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# ── Transactional channels (future-ready, unused in MVP) ─────
# EMAIL_PROVIDER=console
# SMTP_HOST="" / SMTP_PORT="" / SMTP_USER="" / SMTP_PASSWORD="" / SMTP_FROM=""
# WHATSAPP_ENABLED=false
# TWILIO_ACCOUNT_SID="" / TWILIO_AUTH_TOKEN="" / TWILIO_PHONE_NUMBER=""

# ── Payments (disabled in the MVP — cash between parties) ────
PAYMENTS_ENABLED=false
PLATFORM_COMMISSION_RATE=0.10
# STRIPE_SECRET_KEY="" / STRIPE_WEBHOOK_SECRET=""

# ── Seeding ──────────────────────────────────────────────────
# Shared development password for the demo accounts (admin / customer /
# professional @alomaalem.ma). This value is NOT a production credential.
SEED_PASSWORD="Demo@12345"

# ── Test harness ─────────────────────────────────────────────────────────────
# Optional shared secret allowing scripts/smoke-api.sh to skip rate limits.
# Leave this UNSET in production: the bypass only activates when the header
# matches, and an empty value disables it entirely.
RATE_LIMIT_BYPASS_SECRET=""
# Optional shared secret protecting POST /api/cron/expire. Required in production.
CRON_SECRET=""
